<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cv_container"
    android:layout_width="132dp"
    android:layout_height="50dp"
    android:layout_margin="4dp"
    app:cardCornerRadius="4dp"
    app:cardElevation="10dp">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:id="@+id/view_divider"
            android:background="#5a7dfe"
            android:layout_width="5dp"
            android:layout_height="match_parent"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/iv_currency_prefix"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/cpx_icon_clock"
                    android:contentDescription="@string/currency_symbol"/>
                <TextView
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:gravity="center_horizontal"
                    android:layout_gravity="bottom"
                    android:id="@+id/tv_amount_original"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="1dp"
                    android:layout_marginRight="1dp"
                    android:maxLines="1"
                    android:layout_marginHorizontal="1dp"/>
                <TextView
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#4800aa"
                    android:gravity="center_horizontal"
                    android:id="@+id/tv_currency_pre"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:layout_marginStart="2dp"/>
                <TextView
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#4800aa"
                    android:gravity="start"
                    android:id="@+id/tv_amount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"/>
                <TextView
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#4800aa"
                    android:gravity="center_horizontal"
                    android:id="@+id/tv_currency_post"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:layout_marginStart="2dp"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp">
                <TextView
                    android:textSize="14sp"
                    android:textColor="#8e8e93"
                    android:id="@+id/tv_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:fontFamily="sans-serif-medium"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="#8e8e93"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="|"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp"/>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:id="@+id/iv_star1"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:src="@drawable/cpx_icon_star"/>
                    <ImageView
                        android:id="@+id/iv_star2"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:src="@drawable/cpx_icon_star"/>
                    <ImageView
                        android:id="@+id/iv_star3"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:src="@drawable/cpx_icon_star"/>
                    <ImageView
                        android:id="@+id/iv_star4"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:src="@drawable/cpx_icon_star"/>
                    <ImageView
                        android:id="@+id/iv_star5"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:src="@drawable/cpx_icon_star"/>
                </LinearLayout>
                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="2dp">
                    <TextView
                        android:textSize="8sp"
                        android:textColor="#8e8e93"
                        android:id="@+id/tv_amountRatings"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:layout_alignParentBottom="true"/>
                </RelativeLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
