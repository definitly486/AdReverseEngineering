<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="bottom"
    android:orientation="horizontal"
    android:paddingTop="5dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/messageGlobalPic2"
        android:layout_width="40dp"
        android:layout_height="40dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/answerInMessage2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="3dp"
            android:alpha="0.8"
            android:layout_marginStart="7dp">
            <ImageView
                android:background="@drawable/slider"
                android:layout_width="3dp"
                android:layout_height="match_parent"
                android:scaleY="0.8"
                android:backgroundTint="@color/message_background"/>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/message_bubble"
                android:padding="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:backgroundTint="@color/message_background">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/background"
                        android:id="@+id/answerInMessageName2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nickname"
                        android:maxLength="10"
                        android:fontFamily="sans-serif-medium"/>
                    <ImageView
                        android:id="@+id/answerInMessagePremiumStar2"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:src="@drawable/premium_star"
                        android:layout_marginStart="4dp"/>
                </LinearLayout>
                <TextView
                    android:textSize="10sp"
                    android:textColor="@color/background"
                    android:ellipsize="end"
                    android:id="@+id/answerInMessageText2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Some long message Some long message Some long message Some long message Some long message Some long message"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:maxLength="30"
                    android:alpha="0.8"/>
            </LinearLayout>
        </LinearLayout>
        <androidx.cardview.widget.CardView
            android:id="@+id/globalChatImageMessageLay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:elevation="0dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:cardMaxElevation="0dp">
            <ImageView
                android:id="@+id/messageGlobalImage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:maxWidth="260dp"/>
        </androidx.cardview.widget.CardView>
        <TextView
            android:textColor="#860a0a"
            android:id="@+id/messageGlobalImageWarning"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="@string/pavloffme_578"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="7dp"/>
    </LinearLayout>
</LinearLayout>
