<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="bottom"
    android:orientation="horizontal"
    android:paddingTop="5dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/messageGlobalPic"
        android:layout_width="40dp"
        android:layout_height="40dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/answerInMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="3dp"
            android:alpha="0.8"
            android:layout_marginStart="7dp">
            <ImageView
                android:background="@drawable/slider"
                android:layout_width="3dp"
                android:layout_height="match_parent"
                android:scaleY="0.8"
                android:backgroundTint="@color/message_background"/>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/message_bubble"
                android:padding="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:backgroundTint="@color/message_background">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/global_chat_answer_text"
                        android:id="@+id/answerInMessageName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nickname"
                        android:maxLength="10"
                        android:fontFamily="@font/inter_semibold"/>
                    <ImageView
                        android:id="@+id/answerInMessagePremiumStar"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:src="@drawable/premium_star"
                        android:layout_marginStart="4dp"/>
                </LinearLayout>
                <TextView
                    android:textSize="10sp"
                    android:textColor="@color/global_chat_answer_text"
                    android:ellipsize="end"
                    android:id="@+id/answerInMessageText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Some long message Some long message Some long message Some long message Some long message Some long message"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:maxLength="30"
                    android:alpha="0.8"
                    android:fontFamily="@font/inter"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="start"
            android:orientation="vertical"
            android:id="@+id/globalChatTextMessageLay"
            android:background="@drawable/message_bubble"
            android:padding="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:backgroundTint="@color/global_chat_message_bubble">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="12sp"
                    android:id="@+id/messageGlobalName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nickname"
                    android:maxLength="10"
                    android:fontFamily="@font/inter_semibold"/>
                <ImageView
                    android:id="@+id/messageGlobalPremiumStar"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/premium_star"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>
            <TextView
                android:autoLink="all"
                android:linksClickable="true"
                android:id="@+id/messageGlobalText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="260dp"
                android:text="Текст собственного сообщения"
                android:fontFamily="@font/inter"/>
            <TextView
                android:textSize="10sp"
                android:id="@+id/messageGlobalSendTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12:56"
                android:alpha="0.7"
                android:fontFamily="@font/inter"
                android:textAlignment="textStart"/>
            <TextView
                android:textColor="#860a0a"
                android:id="@+id/messageGlobalTextWarning"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pavloffme_578"
                android:fontFamily="sans-serif-medium"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
