<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/button"
    android:padding="10dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:elevation="10dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/menuReply"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_width="25dp"
            android:layout_height="25dp"
            app:srcCompat="@drawable/reply"
            app:tint="@color/balance"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/button_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/adcoinmini_s398"
            android:layout_marginStart="7dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/menuReport"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp">
        <ImageView
            android:layout_width="25dp"
            android:layout_height="25dp"
            app:srcCompat="@drawable/report"
            app:tint="@color/balance"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/button_text"
            android:id="@+id/menuReportText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pavloffme_575"
            android:layout_marginStart="7dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/menuDelete"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp">
        <ImageView
            android:layout_width="25dp"
            android:layout_height="25dp"
            app:srcCompat="@drawable/delete"
            app:tint="@color/balance"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/button_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/adcoinmini_s399"
            android:layout_marginStart="7dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/menuBan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp">
        <ImageView
            android:layout_width="25dp"
            android:layout_height="25dp"
            app:srcCompat="@drawable/person_remove"
            app:tint="@color/balance"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/button_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pavloffme_576"
            android:layout_marginStart="7dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/menuWarn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp">
        <ImageView
            android:layout_width="25dp"
            android:layout_height="25dp"
            app:srcCompat="@drawable/warning"
            app:tint="@color/balance"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/button_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pavloffme_577"
            android:layout_marginStart="7dp"/>
    </LinearLayout>
</LinearLayout>
