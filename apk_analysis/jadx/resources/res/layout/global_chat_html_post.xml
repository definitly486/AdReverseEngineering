<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="bottom"
    android:orientation="horizontal"
    android:paddingTop="5dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/messageGlobalPostPic"
        android:layout_width="40dp"
        android:layout_height="40dp"/>
    <LinearLayout
        android:gravity="start"
        android:orientation="vertical"
        android:id="@+id/globalChatPostMessageLay"
        android:background="@drawable/message_bubble"
        android:padding="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:backgroundTint="@color/global_chat_message_bubble">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="12sp"
                android:id="@+id/messageGlobalPostName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nickname"
                android:maxLength="10"
                android:fontFamily="@font/inter_semibold"/>
            <ImageView
                android:id="@+id/messageGlobalPostPremiumStar"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/premium_star"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
        <androidx.cardview.widget.CardView
            android:background="@color/global_chat_message_bubble"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:elevation="0dp"
            android:backgroundTint="@color/global_chat_message_bubble"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:cardMaxElevation="0dp">
            <ImageView
                android:id="@+id/messageGlobalPostImage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"/>
        </androidx.cardview.widget.CardView>
        <TextView
            android:id="@+id/messageGlobalPostText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:maxWidth="260dp"
            android:text="Текст собственного сообщения"
            android:fontFamily="@font/inter"/>
        <TextView
            android:textSize="10sp"
            android:id="@+id/messageGlobalPostSendTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="12:56"
            android:alpha="0.7"
            android:fontFamily="@font/inter"
            android:textAlignment="textStart"/>
    </LinearLayout>
</LinearLayout>
