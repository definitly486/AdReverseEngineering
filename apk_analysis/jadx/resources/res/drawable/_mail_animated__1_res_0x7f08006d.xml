<?xml version="1.0" encoding="utf-8"?>
<set xmlns:android="http://schemas.android.com/apk/res/android" xmlns:aapt="http://schemas.android.com/aapt" android:ordering="sequentially">
    <objectAnimator
        android:interpolator="@android:interpolator/fast_out_slow_in"
        android:duration="280"
        android:valueFrom="-0.6"
        android:valueTo="1.12"
        android:valueType="floatType"
        android:propertyName="scaleY"/>
    <objectAnimator
        android:interpolator="@android:interpolator/fast_out_slow_in"
        android:duration="140"
        android:valueFrom="1.12"
        android:valueTo="0.96"
        android:valueType="floatType"
        android:propertyName="scaleY"/>
    <objectAnimator
        android:interpolator="@android:interpolator/linear_out_slow_in"
        android:duration="140"
        android:valueFrom="0.96"
        android:valueTo="1"
        android:valueType="floatType"
        android:propertyName="scaleY"/>
</set>
