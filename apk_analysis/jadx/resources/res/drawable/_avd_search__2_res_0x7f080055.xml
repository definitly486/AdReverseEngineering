<?xml version="1.0" encoding="utf-8"?>
<set xmlns:android="http://schemas.android.com/apk/res/android" xmlns:aapt="http://schemas.android.com/aapt">
    <objectAnimator
        android:interpolator="@android:interpolator/fast_out_slow_in"
        android:duration="1000"
        android:startOffset="0">
        <propertyValuesHolder
            android:valueType="floatType"
            android:propertyName="scaleX">
            <keyframe
                android:value="0"
                android:valueType="floatType"
                android:fraction="0"/>
            <keyframe
                android:value="0"
                android:valueType="floatType"
                android:fraction="0.68"/>
            <keyframe
                android:value="0.9"
                android:valueType="floatType"
                android:fraction="0.8"/>
            <keyframe
                android:value="0"
                android:valueType="floatType"
                android:fraction="0.96"/>
            <keyframe
                android:value="0"
                android:valueType="floatType"
                android:fraction="1"/>
        </propertyValuesHolder>
        <propertyValuesHolder
            android:valueType="floatType"
            android:propertyName="scaleY">
            <keyframe
                android:value="0"
                android:valueType="floatType"
                android:fraction="0"/>
            <keyframe
                android:value="0"
                android:valueType="floatType"
                android:fraction="0.68"/>
            <keyframe
                android:value="0.9"
                android:valueType="floatType"
                android:fraction="0.8"/>
            <keyframe
                android:value="0"
                android:valueType="floatType"
                android:fraction="0.96"/>
            <keyframe
                android:value="0"
                android:valueType="floatType"
                android:fraction="1"/>
        </propertyValuesHolder>
        <propertyValuesHolder
            android:valueType="floatType"
            android:propertyName="rotation">
            <keyframe
                android:value="0"
                android:valueType="floatType"
                android:fraction="0"/>
            <keyframe
                android:value="0"
                android:valueType="floatType"
                android:fraction="0.68"/>
            <keyframe
                android:value="90"
                android:valueType="floatType"
                android:fraction="0.96"/>
            <keyframe
                android:value="90"
                android:valueType="floatType"
                android:fraction="1"/>
        </propertyValuesHolder>
    </objectAnimator>
</set>
