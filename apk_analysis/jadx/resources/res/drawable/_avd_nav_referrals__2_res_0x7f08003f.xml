<?xml version="1.0" encoding="utf-8"?>
<set xmlns:android="http://schemas.android.com/apk/res/android" xmlns:aapt="http://schemas.android.com/aapt">
    <objectAnimator
        android:interpolator="@android:interpolator/fast_out_slow_in"
        android:duration="900"
        android:startOffset="0">
        <propertyValuesHolder
            android:valueType="floatType"
            android:propertyName="rotation">
            <keyframe
                android:value="0"
                android:valueType="floatType"
                android:fraction="0"/>
            <keyframe
                android:value="-30"
                android:valueType="floatType"
                android:fraction="0.12"/>
            <keyframe
                android:value="200"
                android:valueType="floatType"
                android:fraction="0.5"/>
            <keyframe
                android:value="170"
                android:valueType="floatType"
                android:fraction="0.7"/>
            <keyframe
                android:value="184"
                android:valueType="floatType"
                android:fraction="0.85"/>
            <keyframe
                android:value="180"
                android:valueType="floatType"
                android:fraction="1"/>
        </propertyValuesHolder>
        <propertyValuesHolder
            android:valueType="floatType"
            android:propertyName="scaleX">
            <keyframe
                android:value="1"
                android:valueType="floatType"
                android:fraction="0"/>
            <keyframe
                android:value="0.6"
                android:valueType="floatType"
                android:fraction="0.12"/>
            <keyframe
                android:value="1.45"
                android:valueType="floatType"
                android:fraction="0.45"/>
            <keyframe
                android:value="0.9"
                android:valueType="floatType"
                android:fraction="0.65"/>
            <keyframe
                android:value="1.06"
                android:valueType="floatType"
                android:fraction="0.82"/>
            <keyframe
                android:value="1"
                android:valueType="floatType"
                android:fraction="1"/>
        </propertyValuesHolder>
        <propertyValuesHolder
            android:valueType="floatType"
            android:propertyName="scaleY">
            <keyframe
                android:value="1"
                android:valueType="floatType"
                android:fraction="0"/>
            <keyframe
                android:value="0.6"
                android:valueType="floatType"
                android:fraction="0.12"/>
            <keyframe
                android:value="1.45"
                android:valueType="floatType"
                android:fraction="0.45"/>
            <keyframe
                android:value="0.9"
                android:valueType="floatType"
                android:fraction="0.65"/>
            <keyframe
                android:value="1.06"
                android:valueType="floatType"
                android:fraction="0.82"/>
            <keyframe
                android:value="1"
                android:valueType="floatType"
                android:fraction="1"/>
        </propertyValuesHolder>
    </objectAnimator>
</set>
