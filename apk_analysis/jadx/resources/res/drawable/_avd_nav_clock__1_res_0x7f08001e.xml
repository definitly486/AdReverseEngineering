<?xml version="1.0" encoding="utf-8"?>
<set xmlns:android="http://schemas.android.com/apk/res/android" xmlns:aapt="http://schemas.android.com/aapt">
    <objectAnimator
        android:interpolator="@android:interpolator/fast_out_slow_in"
        android:duration="1000"
        android:startOffset="0">
        <propertyValuesHolder
            android:valueType="floatType"
            android:propertyName="rotation">
            <keyframe
                android:value="0"
                android:valueType="floatType"
                android:fraction="0"/>
            <keyframe
                android:value="-9"
                android:valueType="floatType"
                android:fraction="0.05"/>
            <keyframe
                android:value="9"
                android:valueType="floatType"
                android:fraction="0.1"/>
            <keyframe
                android:value="-8"
                android:valueType="floatType"
                android:fraction="0.15"/>
            <keyframe
                android:value="7"
                android:valueType="floatType"
                android:fraction="0.2"/>
            <keyframe
                android:value="-5"
                android:valueType="floatType"
                android:fraction="0.25"/>
            <keyframe
                android:value="3"
                android:valueType="floatType"
                android:fraction="0.3"/>
            <keyframe
                android:value="0"
                android:valueType="floatType"
                android:fraction="0.36"/>
            <keyframe
                android:value="0"
                android:valueType="floatType"
                android:fraction="1"/>
        </propertyValuesHolder>
        <propertyValuesHolder
            android:valueType="floatType"
            android:propertyName="translateY">
            <keyframe
                android:value="0"
                android:valueType="floatType"
                android:fraction="0"/>
            <keyframe
                android:value="10"
                android:valueType="floatType"
                android:fraction="0.06"/>
            <keyframe
                android:value="-40"
                android:valueType="floatType"
                android:fraction="0.2"/>
            <keyframe
                android:value="0"
                android:valueType="floatType"
                android:fraction="0.36"/>
            <keyframe
                android:value="0"
                android:valueType="floatType"
                android:fraction="1"/>
        </propertyValuesHolder>
        <propertyValuesHolder
            android:valueType="floatType"
            android:propertyName="scaleX">
            <keyframe
                android:value="1"
                android:valueType="floatType"
                android:fraction="0"/>
            <keyframe
                android:value="1.06"
                android:valueType="floatType"
                android:fraction="0.06"/>
            <keyframe
                android:value="0.96"
                android:valueType="floatType"
                android:fraction="0.2"/>
            <keyframe
                android:value="1.03"
                android:valueType="floatType"
                android:fraction="0.36"/>
            <keyframe
                android:value="1"
                android:valueType="floatType"
                android:fraction="0.5"/>
            <keyframe
                android:value="1"
                android:valueType="floatType"
                android:fraction="1"/>
        </propertyValuesHolder>
        <propertyValuesHolder
            android:valueType="floatType"
            android:propertyName="scaleY">
            <keyframe
                android:value="1"
                android:valueType="floatType"
                android:fraction="0"/>
            <keyframe
                android:value="0.92"
                android:valueType="floatType"
                android:fraction="0.06"/>
            <keyframe
                android:value="1.05"
                android:valueType="floatType"
                android:fraction="0.2"/>
            <keyframe
                android:value="0.97"
                android:valueType="floatType"
                android:fraction="0.36"/>
            <keyframe
                android:value="1"
                android:valueType="floatType"
                android:fraction="0.5"/>
            <keyframe
                android:value="1"
                android:valueType="floatType"
                android:fraction="1"/>
        </propertyValuesHolder>
    </objectAnimator>
</set>
