<?xml version="1.0" encoding="utf-8"?>
<set xmlns:android="http://schemas.android.com/apk/res/android" xmlns:aapt="http://schemas.android.com/aapt">
    <objectAnimator
        android:interpolator="@android:interpolator/fast_out_slow_in"
        android:duration="900"
        android:startOffset="0">
        <propertyValuesHolder
            android:valueType="floatType"
            android:propertyName="scaleX">
            <keyframe
                android:value="1"
                android:valueType="floatType"
                android:fraction="0"/>
            <keyframe
                android:value="1.14"
                android:valueType="floatType"
                android:fraction="0.16"/>
            <keyframe
                android:value="0.88"
                android:valueType="floatType"
                android:fraction="0.42"/>
            <keyframe
                android:value="1.07"
                android:valueType="floatType"
                android:fraction="0.6"/>
            <keyframe
                android:value="0.97"
                android:valueType="floatType"
                android:fraction="0.78"/>
            <keyframe
                android:value="1"
                android:valueType="floatType"
                android:fraction="1"/>
        </propertyValuesHolder>
        <propertyValuesHolder
            android:valueType="floatType"
            android:propertyName="scaleY">
            <keyframe
                android:value="1"
                android:valueType="floatType"
                android:fraction="0"/>
            <keyframe
                android:value="0.76"
                android:valueType="floatType"
                android:fraction="0.16"/>
            <keyframe
                android:value="1.18"
                android:valueType="floatType"
                android:fraction="0.42"/>
            <keyframe
                android:value="0.94"
                android:valueType="floatType"
                android:fraction="0.6"/>
            <keyframe
                android:value="1.03"
                android:valueType="floatType"
                android:fraction="0.78"/>
            <keyframe
                android:value="1"
                android:valueType="floatType"
                android:fraction="1"/>
        </propertyValuesHolder>
        <propertyValuesHolder
            android:valueType="floatType"
            android:propertyName="translateY">
            <keyframe
                android:value="0"
                android:valueType="floatType"
                android:fraction="0"/>
            <keyframe
                android:value="40"
                android:valueType="floatType"
                android:fraction="0.16"/>
            <keyframe
                android:value="-70"
                android:valueType="floatType"
                android:fraction="0.42"/>
            <keyframe
                android:value="8"
                android:valueType="floatType"
                android:fraction="0.62"/>
            <keyframe
                android:value="-6"
                android:valueType="floatType"
                android:fraction="0.8"/>
            <keyframe
                android:value="0"
                android:valueType="floatType"
                android:fraction="1"/>
        </propertyValuesHolder>
        <propertyValuesHolder
            android:valueType="floatType"
            android:propertyName="rotation">
            <keyframe
                android:value="0"
                android:valueType="floatType"
                android:fraction="0"/>
            <keyframe
                android:value="-6"
                android:valueType="floatType"
                android:fraction="0.16"/>
            <keyframe
                android:value="9"
                android:valueType="floatType"
                android:fraction="0.42"/>
            <keyframe
                android:value="-4"
                android:valueType="floatType"
                android:fraction="0.62"/>
            <keyframe
                android:value="2"
                android:valueType="floatType"
                android:fraction="0.8"/>
            <keyframe
                android:value="0"
                android:valueType="floatType"
                android:fraction="1"/>
        </propertyValuesHolder>
    </objectAnimator>
</set>
