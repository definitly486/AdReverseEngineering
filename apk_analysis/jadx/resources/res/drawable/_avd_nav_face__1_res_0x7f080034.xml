<?xml version="1.0" encoding="utf-8"?>
<set xmlns:android="http://schemas.android.com/apk/res/android" xmlns:aapt="http://schemas.android.com/aapt">
    <objectAnimator
        android:interpolator="@android:interpolator/fast_out_slow_in"
        android:duration="950"
        android:startOffset="0">
        <propertyValuesHolder
            android:valueType="floatType"
            android:propertyName="rotation">
            <keyframe
                android:value="0"
                android:valueType="floatType"
                android:fraction="0"/>
            <keyframe
                android:value="-10"
                android:valueType="floatType"
                android:fraction="0.18"/>
            <keyframe
                android:value="12"
                android:valueType="floatType"
                android:fraction="0.42"/>
            <keyframe
                android:value="-5"
                android:valueType="floatType"
                android:fraction="0.64"/>
            <keyframe
                android:value="2"
                android:valueType="floatType"
                android:fraction="0.82"/>
            <keyframe
                android:value="0"
                android:valueType="floatType"
                android:fraction="1"/>
        </propertyValuesHolder>
        <propertyValuesHolder
            android:valueType="floatType"
            android:propertyName="translateY">
            <keyframe
                android:value="0"
                android:valueType="floatType"
                android:fraction="0"/>
            <keyframe
                android:value="20"
                android:valueType="floatType"
                android:fraction="0.14"/>
            <keyframe
                android:value="-60"
                android:valueType="floatType"
                android:fraction="0.36"/>
            <keyframe
                android:value="0"
                android:valueType="floatType"
                android:fraction="0.56"/>
            <keyframe
                android:value="0"
                android:valueType="floatType"
                android:fraction="1"/>
        </propertyValuesHolder>
        <propertyValuesHolder
            android:valueType="floatType"
            android:propertyName="scaleX">
            <keyframe
                android:value="1"
                android:valueType="floatType"
                android:fraction="0"/>
            <keyframe
                android:value="1.1"
                android:valueType="floatType"
                android:fraction="0.14"/>
            <keyframe
                android:value="0.95"
                android:valueType="floatType"
                android:fraction="0.36"/>
            <keyframe
                android:value="1.05"
                android:valueType="floatType"
                android:fraction="0.56"/>
            <keyframe
                android:value="1"
                android:valueType="floatType"
                android:fraction="0.7"/>
            <keyframe
                android:value="1"
                android:valueType="floatType"
                android:fraction="1"/>
        </propertyValuesHolder>
        <propertyValuesHolder
            android:valueType="floatType"
            android:propertyName="scaleY">
            <keyframe
                android:value="1"
                android:valueType="floatType"
                android:fraction="0"/>
            <keyframe
                android:value="0.88"
                android:valueType="floatType"
                android:fraction="0.14"/>
            <keyframe
                android:value="1.07"
                android:valueType="floatType"
                android:fraction="0.36"/>
            <keyframe
                android:value="0.96"
                android:valueType="floatType"
                android:fraction="0.56"/>
            <keyframe
                android:value="1"
                android:valueType="floatType"
                android:fraction="0.7"/>
            <keyframe
                android:value="1"
                android:valueType="floatType"
                android:fraction="1"/>
        </propertyValuesHolder>
    </objectAnimator>
</set>
