<?xml version="1.0" encoding="utf-8"?>
<set xmlns:android="http://schemas.android.com/apk/res/android" xmlns:aapt="http://schemas.android.com/aapt" android:ordering="sequentially">
    <objectAnimator
        android:interpolator="@android:interpolator/fast_out_slow_in"
        android:duration="110"
        android:valueFrom="0"
        android:valueTo="16"
        android:valueType="floatType"
        android:propertyName="rotation"/>
    <objectAnimator
        android:interpolator="@android:interpolator/fast_out_slow_in"
        android:duration="160"
        android:valueFrom="16"
        android:valueTo="-13"
        android:valueType="floatType"
        android:propertyName="rotation"/>
    <objectAnimator
        android:interpolator="@android:interpolator/fast_out_slow_in"
        android:duration="150"
        android:valueFrom="-13"
        android:valueTo="9"
        android:valueType="floatType"
        android:propertyName="rotation"/>
    <objectAnimator
        android:interpolator="@android:interpolator/fast_out_slow_in"
        android:duration="130"
        android:valueFrom="9"
        android:valueTo="-5"
        android:valueType="floatType"
        android:propertyName="rotation"/>
    <objectAnimator
        android:interpolator="@android:interpolator/fast_out_slow_in"
        android:duration="110"
        android:valueFrom="-5"
        android:valueTo="2"
        android:valueType="floatType"
        android:propertyName="rotation"/>
    <objectAnimator
        android:interpolator="@android:interpolator/linear_out_slow_in"
        android:duration="100"
        android:valueFrom="2"
        android:valueTo="0"
        android:valueType="floatType"
        android:propertyName="rotation"/>
</set>
