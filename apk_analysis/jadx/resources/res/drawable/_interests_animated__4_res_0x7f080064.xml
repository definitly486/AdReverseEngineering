<?xml version="1.0" encoding="utf-8"?>
<set xmlns:android="http://schemas.android.com/apk/res/android" xmlns:aapt="http://schemas.android.com/aapt" android:ordering="together">
    <set android:ordering="sequentially">
        <objectAnimator
            android:interpolator="@android:interpolator/fast_out_slow_in"
            android:duration="240"
            android:startOffset="120"
            android:valueFrom="0.8"
            android:valueTo="1"
            android:valueType="floatType"
            android:propertyName="scaleX"/>
        <objectAnimator
            android:interpolator="@android:interpolator/linear_out_slow_in"
            android:duration="70"
            android:valueFrom="1"
            android:valueTo="1.14"
            android:valueType="floatType"
            android:propertyName="scaleX"/>
        <objectAnimator
            android:interpolator="@android:interpolator/fast_out_slow_in"
            android:duration="120"
            android:valueFrom="1.14"
            android:valueTo="0.96"
            android:valueType="floatType"
            android:propertyName="scaleX"/>
        <objectAnimator
            android:interpolator="@android:interpolator/linear_out_slow_in"
            android:duration="120"
            android:valueFrom="0.96"
            android:valueTo="1"
            android:valueType="floatType"
            android:propertyName="scaleX"/>
    </set>
    <set android:ordering="sequentially">
        <objectAnimator
            android:interpolator="@android:interpolator/fast_out_slow_in"
            android:duration="240"
            android:startOffset="120"
            android:valueFrom="0.8"
            android:valueTo="1"
            android:valueType="floatType"
            android:propertyName="scaleY"/>
        <objectAnimator
            android:interpolator="@android:interpolator/linear_out_slow_in"
            android:duration="70"
            android:valueFrom="1"
            android:valueTo="0.84"
            android:valueType="floatType"
            android:propertyName="scaleY"/>
        <objectAnimator
            android:interpolator="@android:interpolator/fast_out_slow_in"
            android:duration="120"
            android:valueFrom="0.84"
            android:valueTo="1.06"
            android:valueType="floatType"
            android:propertyName="scaleY"/>
        <objectAnimator
            android:interpolator="@android:interpolator/linear_out_slow_in"
            android:duration="120"
            android:valueFrom="1.06"
            android:valueTo="1"
            android:valueType="floatType"
            android:propertyName="scaleY"/>
    </set>
</set>
