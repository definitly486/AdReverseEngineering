<?xml version="1.0" encoding="utf-8"?>
<set xmlns:android="http://schemas.android.com/apk/res/android" xmlns:aapt="http://schemas.android.com/aapt">
    <objectAnimator
        android:interpolator="@android:interpolator/fast_out_slow_in"
        android:duration="950"
        android:startOffset="0">
        <propertyValuesHolder
            android:valueType="floatType"
            android:propertyName="translateY">
            <keyframe
                android:value="0"
                android:valueType="floatType"
                android:fraction="0"/>
            <keyframe
                android:value="70"
                android:valueType="floatType"
                android:fraction="0.14"/>
            <keyframe
                android:value="-110"
                android:valueType="floatType"
                android:fraction="0.38"/>
            <keyframe
                android:value="15"
                android:valueType="floatType"
                android:fraction="0.56"/>
            <keyframe
                android:value="-6"
                android:valueType="floatType"
                android:fraction="0.7"/>
            <keyframe
                android:value="0"
                android:valueType="floatType"
                android:fraction="0.82"/>
            <keyframe
                android:value="0"
                android:valueType="floatType"
                android:fraction="1"/>
        </propertyValuesHolder>
        <propertyValuesHolder
            android:valueType="floatType"
            android:propertyName="rotation">
            <keyframe
                android:value="0"
                android:valueType="floatType"
                android:fraction="0"/>
            <keyframe
                android:value="0"
                android:valueType="floatType"
                android:fraction="0.38"/>
            <keyframe
                android:value="12"
                android:valueType="floatType"
                android:fraction="0.52"/>
            <keyframe
                android:value="-9"
                android:valueType="floatType"
                android:fraction="0.66"/>
            <keyframe
                android:value="5"
                android:valueType="floatType"
                android:fraction="0.8"/>
            <keyframe
                android:value="-2"
                android:valueType="floatType"
                android:fraction="0.9"/>
            <keyframe
                android:value="0"
                android:valueType="floatType"
                android:fraction="1"/>
        </propertyValuesHolder>
    </objectAnimator>
</set>
