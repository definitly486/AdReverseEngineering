<?xml version="1.0" encoding="utf-8"?>
<set xmlns:android="http://schemas.android.com/apk/res/android" xmlns:aapt="http://schemas.android.com/aapt">
    <objectAnimator
        android:interpolator="@android:interpolator/linear"
        android:duration="1000">
        <propertyValuesHolder
            android:valueType="floatType"
            android:propertyName="scaleY">
            <keyframe
                android:value="1"
                android:fraction="0"/>
            <keyframe
                android:value="0.82"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:fraction="0.15"/>
            <keyframe
                android:value="1.1"
                android:interpolator="@android:interpolator/decelerate_cubic"
                android:fraction="0.3"/>
            <keyframe
                android:value="1"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:fraction="0.55"/>
            <keyframe
                android:value="0.88"
                android:interpolator="@android:interpolator/decelerate_cubic"
                android:fraction="0.68"/>
            <keyframe
                android:value="1.04"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:fraction="0.82"/>
            <keyframe
                android:value="1"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:fraction="1"/>
        </propertyValuesHolder>
    </objectAnimator>
    <objectAnimator
        android:interpolator="@android:interpolator/linear"
        android:duration="1000">
        <propertyValuesHolder
            android:valueType="floatType"
            android:propertyName="scaleX">
            <keyframe
                android:value="1"
                android:fraction="0"/>
            <keyframe
                android:value="1.12"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:fraction="0.15"/>
            <keyframe
                android:value="0.93"
                android:interpolator="@android:interpolator/decelerate_cubic"
                android:fraction="0.3"/>
            <keyframe
                android:value="1"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:fraction="0.55"/>
            <keyframe
                android:value="1.08"
                android:interpolator="@android:interpolator/decelerate_cubic"
                android:fraction="0.68"/>
            <keyframe
                android:value="0.98"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:fraction="0.82"/>
            <keyframe
                android:value="1"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:fraction="1"/>
        </propertyValuesHolder>
    </objectAnimator>
    <objectAnimator
        android:interpolator="@android:interpolator/linear"
        android:duration="1000">
        <propertyValuesHolder
            android:valueType="floatType"
            android:propertyName="translateY">
            <keyframe
                android:value="0"
                android:fraction="0"/>
            <keyframe
                android:value="0"
                android:fraction="0.15"/>
            <keyframe
                android:value="-10"
                android:interpolator="@android:interpolator/decelerate_cubic"
                android:fraction="0.42"/>
            <keyframe
                android:value="0"
                android:interpolator="@android:interpolator/accelerate_quad"
                android:fraction="0.66"/>
            <keyframe
                android:value="-2"
                android:interpolator="@android:interpolator/decelerate_cubic"
                android:fraction="0.8"/>
            <keyframe
                android:value="0"
                android:interpolator="@android:interpolator/accelerate_quad"
                android:fraction="0.9"/>
            <keyframe
                android:value="0"
                android:fraction="1"/>
        </propertyValuesHolder>
    </objectAnimator>
</set>
