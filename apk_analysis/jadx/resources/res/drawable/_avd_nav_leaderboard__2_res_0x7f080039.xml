                android:value="1.16"
                android:valueType="floatType"
                android:fraction="0.32"/>
            <keyframe
                android:value="0.94"
                android:valueType="floatType"
                android:fraction="0.46"/>
            <keyframe
                android:value="1.02"
                android:valueType="floatType"
                android:fraction="0.6"/>
