<?xml version="1.0" encoding="utf-8"?>
<set
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:aapt="http://schemas.android.com/aapt">
    <objectAnimator android:interpolator="@android:interpolator/linear" android:duration="1000">
        <propertyValuesHolder android:valueType="floatType" android:propertyName="rotation">
            <keyframe android:value="0" android:fraction="0.0" />
            <keyframe android:value="-3" android:interpolator="@android:interpolator/fast_out_slow_in" android:fraction="0.15" />
            <keyframe android:value="14" android:interpolator="@android:interpolator/decelerate_cubic" android:fraction="0.42" />
            <keyframe android:value="4" android:interpolator="@android:interpolator/accelerate_quad" android:fraction="0.66" />
            <keyframe android:value="-2" android:interpolator="@android:interpolator/fast_out_slow_in" android:fraction="0.82" />
            <keyframe android:value="0" android:interpolator="@android:interpolator/fast_out_slow_in" android:fraction="1.0" />
        </propertyValuesHolder>
    </objectAnimator>
    <objectAnimator android:interpolator="@android:interpolator/linear" android:duration="1000">
        <propertyValuesHolder android:valueType="floatType" android:propertyName="translateY">
            <keyframe android:value="0" android:fraction="0.0" />
            <keyframe android:value="1.5" android:interpolator="@android:interpolator/fast_out_slow_in" android:fraction="0.15" />
            <keyframe android:value="-3" android:interpolator="@android:interpolator/decelerate_cubic" android:fraction="0.42" />
            <keyframe android:value="1" android:interpolator="@android:interpolator/accelerate_quad" android:fraction="0.66" />
            <keyframe android:value="0" android:interpolator="@android:interpolator/fast_out_slow_in" android:fraction="1.0" />
        </propertyValuesHolder>
    </objectAnimator>
</set>
