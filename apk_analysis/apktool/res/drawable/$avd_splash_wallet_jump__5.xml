<?xml version="1.0" encoding="utf-8"?>
<set
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:aapt="http://schemas.android.com/aapt">
    <objectAnimator android:interpolator="@android:interpolator/linear" android:duration="250" android:startOffset="700">
        <propertyValuesHolder android:valueType="floatType" android:propertyName="translateX">
            <keyframe android:value="0" android:fraction="0.0" />
            <keyframe android:value="2.5" android:interpolator="@android:interpolator/decelerate_cubic" android:fraction="0.5" />
            <keyframe android:value="0" android:interpolator="@android:interpolator/overshoot" android:fraction="1.0" />
        </propertyValuesHolder>
    </objectAnimator>
    <objectAnimator android:interpolator="@android:interpolator/linear" android:duration="250" android:startOffset="700">
        <propertyValuesHolder android:valueType="floatType" android:propertyName="scaleX">
            <keyframe android:value="1" android:fraction="0.0" />
            <keyframe android:value="0.85" android:interpolator="@android:interpolator/decelerate_cubic" android:fraction="0.5" />
            <keyframe android:value="1" android:interpolator="@android:interpolator/overshoot" android:fraction="1.0" />
        </propertyValuesHolder>
    </objectAnimator>
</set>
