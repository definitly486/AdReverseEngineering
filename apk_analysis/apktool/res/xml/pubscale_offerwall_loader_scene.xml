        <Constraint android:id="@id/appicon" android:layout_width="140.0dp" android:layout_height="140.0dp" app:layout_constraintBottom_toBottomOf="@id/background" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="@id/background" />
        <Constraint android:id="@id/progress_circular">
            <PropertySet app:applyMotionScene="false" app:visibilityMode="ignore" />
        </Constraint>
        <Constraint android:id="@id/overlay" android:layout_width="match_parent" android:layout_height="0.0dp" android:alpha="0.0" app:layout_constraintBottom_toBottomOf="@id/background" app:layout_constraintTop_toTopOf="@id/background" />
    </ConstraintSet>
    <ConstraintSet android:id="@id/portraitEnd">
