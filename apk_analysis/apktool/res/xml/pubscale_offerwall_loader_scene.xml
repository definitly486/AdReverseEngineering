        <Constraint android:id="@id/progress_circular" android:visibility="invisible">
            <PropertySet app:applyMotionScene="false" app:visibilityMode="ignore" />
        </Constraint>
        <Constraint android:id="@id/overlay" android:visibility="invisible" android:layout_width="match_parent" android:layout_height="0.0dp" android:alpha="0.0" app:layout_constraintBottom_toBottomOf="@id/background" app:layout_constraintTop_toTopOf="@id/background" />
    </ConstraintSet>
    <ConstraintSet android:id="@id/landscapeEnd">
        <Constraint android:id="@id/background" android:visibility="invisible" android:layout_width="match_parent" android:layout_height="match_parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />
