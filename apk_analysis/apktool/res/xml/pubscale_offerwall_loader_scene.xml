    </ConstraintSet>
    <Transition app:constraintSetEnd="@id/portraitEnd" app:constraintSetStart="@id/start" app:duration="400" />
    <Transition app:constraintSetEnd="@id/landscapeEnd" app:constraintSetStart="@id/start" app:duration="400" />
</MotionScene>
